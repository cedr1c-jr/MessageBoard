<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Login Page</title>
</head>
<body>

    <h1>Login Page</h1>

    <form action="/login" method="POST">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" placeholder="Username">

        <label for="password">Password:</label>
        <input type="password" id="password" name="password" placeholder="Password">

        <button type="submit">Login</button>

    </form>

    <a class="button" href="/register">Register</a>

    <script>
        // Only allow same-site relative paths, to avoid an open redirect
        const rawNext = new URLSearchParams(location.search).get('next') || '/messages';
        const next = rawNext.startsWith('/') && !rawNext.startsWith('//') ? rawNext : '/messages';

        // Access token expired but refresh cookie still valid? Skip the form.
        (async () => {
            try {
                const res = await fetch('http://localhost:4000/token', {
                    method: 'POST',
                    credentials: 'include'
                });
                if (res.ok) window.location.href = next;
            } catch {}
        })();

        document.querySelector('form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const username = e.target.username.value;
            const password = e.target.password.value;

            const res = await fetch('http://localhost:4000/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ username, password })
            });

            if (res.ok) {
                window.location.href = next;
            } else {
                alert(await res.text());
            }
        }); 
    </script>
</body>
</html>